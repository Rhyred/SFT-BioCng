# Local development configuration only. Do not use these values in production.
POSTGRES_DB=nicegas
POSTGRES_USER=nicegas
POSTGRES_PASSWORD=nicegas_dev_password
POSTGRES_PORT=5432
MQTT_PORT=1883
APP_PORT=8000
DATABASE_HOST=postgres
JWT_SECRET_KEY=nicegas_dev_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service Configuration
AI_PROVIDER=dmr
AI_BASE_URL=http://model-runner.docker.internal/v1
AI_MODEL=huggingface.co/huggingfacetb/smollm2-1.7b-instruct-gguf:latest
AI_TIMEOUT_SECONDS=30.0
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.2
