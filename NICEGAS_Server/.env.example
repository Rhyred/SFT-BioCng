# Local development configuration only. Do not use these values in production.
POSTGRES_DB=nicegas
POSTGRES_USER=nicegas
POSTGRES_PASSWORD=nicegas_dev_password
POSTGRES_PORT=5432
MQTT_PORT=1883
APP_PORT=8000
DATABASE_HOST=postgres
JWT_SECRET_KEY=nicegas_dev_jwt_secret_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service Configuration
# AI_MODEL is the legacy single-model fallback.
# AI_MODEL_CHAT / AI_MODEL_ANALYSIS / AI_MODEL_GENERAL override per task.
# Leave empty to fall back to AI_MODEL.
AI_PROVIDER=dmr
AI_BASE_URL=http://model-runner.docker.internal/v1
AI_MODEL=huggingface.co/huggingfacetb/smollm2-1.7b-instruct-gguf:latest
AI_MODEL_CHAT=huggingface.co/huggingfacetb/smollm2-1.7b-instruct-gguf:latest
AI_MODEL_ANALYSIS=docker.io/ai/qwen3:8b-q4_K_M
AI_MODEL_GENERAL=docker.io/ai/qwen3.5:latest
AI_TIMEOUT_SECONDS=120.0
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.2
AI_AGENT_MAX_TOOL_ROUNDS=5
